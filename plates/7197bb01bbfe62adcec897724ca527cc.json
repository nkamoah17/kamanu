  "kind": "policy",
  "name": "PRespBasis.dw",
  "policy": "// kernel: PRespBasis\n// source: https://aws.amazon.com/blogs/opensource/introducing-dogwood-runtime-verification-for-ai-agents/ (section \"Rate limiting requests vs. responses\")\n// source: https://github.com/dogwood-policy/dogwood/blob/v1.1.1/dogwood-docs/examples/refund_budget_settled_plus_current/README.md (settled sum plus current request)\n// source: https://github.com/dogwood-policy/dogwood/blob/v1.1.1/dogwood-docs/guide/04-temporal-expressions.md#arithmetic-in-comparison-operands\n// A response sum does not see the request being decided, so its amount is added.\n// Needs a dogwood build with --features experimental-arithmetic.\n\n@id(\"pay_cap\")\npermit (\n    principal,\n    action == Kamanu::Action::\"Pay\",\n    resource\n)\nwhen temporal {\n    (sum a for (a: Long), (t: Timepoint). where (\n        formerly within 24h (Kamanu::Action::\"Pay\"::response{ input.amount: a } && tp(t))\n    )) + context.input.amount <= 100\n};\n"
 },
