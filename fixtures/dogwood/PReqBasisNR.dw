// kernel: PReqBasisNR
// source: https://github.com/dogwood-policy/dogwood/blob/v1.1.1/dogwood-docs/examples/refund_budget_settled_plus_current/README.md (a same-kind sum already includes the in-flight amount, so the added term double-counts)
// source: https://github.com/dogwood-policy/dogwood/blob/v1.1.1/dogwood-docs/guide/04-temporal-expressions.md#arithmetic-in-comparison-operands
// Deliberately the double-counting form that README warns about: this is the
// kernel's non-reflexive author running on a reflexive engine.
// Needs a dogwood build with --features experimental-arithmetic.

@id("pay_cap")
permit (
    principal,
    action == Kamanu::Action::"Pay",
    resource
)
when temporal {
    (sum a for (a: Long), (t: Timepoint). where (
        formerly within 24h (Kamanu::Action::"Pay"::request{ input.amount: a } && tp(t))
    )) + context.input.amount <= 100
};
