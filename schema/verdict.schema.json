{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KAMANU verdict",
  "description": "What one TLC run established, and the assumptions it rested on. Extra top-level fields are allowed; the profile holds exactly the five engine constants. facts are the code facts the verdict used, each naming the query and graph that made it; flags give HasReconcile (and, for the task model, HasTimeout) a provenance; graph_hash names the repository's graph, or null. premises, when the verdict was given any, says what each of the six rests on and whether its value was lowered. level is how the verdict was established, by its weakest link, and rests_on lists what it rests on, each with its own level (kamanu.levels).",
  "type": "object",
  "required": ["model", "policy", "bounds", "faults", "has_reconcile", "task", "checks",
               "fairness", "profile", "tlc", "result", "trace", "facts", "flags", "graph_hash", "level"],
  "properties": {
    "model": {"enum": ["safety", "task"]},
    "policy": {"type": "string", "minLength": 1},
    "bounds": {
      "type": "object",
      "required": ["MaxReq", "MaxFails", "Cap", "templates"],
      "properties": {
        "MaxReq": {"$ref": "#/$defs/natural"},
        "MaxFails": {"$ref": "#/$defs/natural"},
        "Cap": {"$ref": "#/$defs/natural"},
        "templates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/template"}}
      }
    },
    "faults": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["clean", "ambiguous"]}
    },
    "has_reconcile": {"type": "boolean"},
    "task": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/task"}]},
    "checks": {
      "type": "object",
      "required": ["invariants", "properties", "deadlock"],
      "properties": {
        "invariants": {"$ref": "#/$defs/names"},
        "properties": {"$ref": "#/$defs/names"},
        "deadlock": {"type": "boolean"}
      }
    },
    "fairness": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/conjunct"}},
    "profile": {
      "type": "object",
      "required": ["Reflexive", "DenyRecord", "Atomic", "Lag", "Scope"],
      "additionalProperties": false,
      "properties": {
        "Reflexive": {"allOf": [{"$ref": "#/$defs/provenanced"},
                                {"properties": {"value": {"type": "boolean"}}}]},
        "DenyRecord": {"allOf": [{"$ref": "#/$defs/provenanced"},
                                 {"properties": {"value": {"enum": ["none", "deny", "error", "request"]}}}]},
        "Atomic": {"allOf": [{"$ref": "#/$defs/provenanced"},
                             {"properties": {"value": {"type": "boolean"}}}]},
        "Lag": {"allOf": [{"$ref": "#/$defs/provenanced"},
                          {"properties": {"value": {"$ref": "#/$defs/natural"}}}]},
        "Scope": {"allOf": [{"$ref": "#/$defs/provenanced"},
                            {"properties": {"value": {"enum": ["ScopeGlobal", "ScopeSession"]}}}]}
      }
    },
    "tlc": {
      "type": "object",
      "required": ["jar_sha256"],
      "properties": {"jar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "result": {
      "type": "object",
      "required": ["status", "violated", "distinct_states"],
      "properties": {
        "status": {"enum": ["PASS", "INVARIANT", "DEADLOCK", "LIVENESS"]},
        "violated": {"type": ["string", "null"]},
        "distinct_states": {"$ref": "#/$defs/natural"}
      },
      "if": {"properties": {"status": {"enum": ["PASS", "DEADLOCK"]}}},
      "then": {"properties": {"violated": {"type": "null"}}}
    },
    "trace": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/trace"}]},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "flags": {
      "type": "object",
      "required": ["HasReconcile"],
      "additionalProperties": false,
      "properties": {
        "HasReconcile": {"$ref": "#/$defs/flag"},
        "HasTimeout": {"$ref": "#/$defs/flag"}
      }
    },
    "graph_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "level": {"$ref": "#/$defs/level"},
    "rests_on": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "name", "level"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "level": {"$ref": "#/$defs/level"},
          "why": {"type": "string", "minLength": 1}
        }
      }
    },
    "premises": {
      "description": "Empty, or all six premises.",
      "anyOf": [{"type": "object", "additionalProperties": false}, {"$ref": "#/$defs/premises"}]
    }
  },
  "allOf": [
    {
      "description": "A PASS carries no trace; anything else must show its counterexample.",
      "if": {"properties": {"result": {"properties": {"status": {"const": "PASS"}}}}},
      "then": {"properties": {"trace": {"type": "null"}}},
      "else": {"properties": {"trace": {"type": "object"}}}
    },
    {
      "description": "The safety harness has no task fields and no Fairness formula.",
      "if": {"properties": {"model": {"const": "safety"}}},
      "then": {"properties": {"task": {"type": "null"}, "fairness": {"maxItems": 0},
                              "flags": {"not": {"required": ["HasTimeout"]}}}},
      "else": {"properties": {"task": {"type": "object"}, "flags": {"required": ["HasTimeout"]}}}
    }
  ],
  "$defs": {
    "natural": {"type": "integer", "minimum": 0},
    "level": {"enum": ["MODEL_PROVEN", "EXHAUSTIVE_FINITE_PASS", "BOUNDED_PASS", "TESTED", "ASSUMED",
                       "REFUTED", "UNKNOWN"]},
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "template": {
      "type": "object",
      "required": ["tool", "amt", "key"],
      "properties": {
        "tool": {"type": "string"},
        "amt": {"type": "integer"},
        "key": {"type": "string"}
      }
    },
    "task": {
      "type": "object",
      "required": ["GoalTemplate", "NeedsApproval", "ApproverFair", "AgentFair", "HasTimeout",
                   "MaskDeadlock"],
      "properties": {
        "GoalTemplate": {"$ref": "#/$defs/template"},
        "NeedsApproval": {"type": "boolean"},
        "ApproverFair": {"type": "boolean"},
        "AgentFair": {"type": "boolean"},
        "HasTimeout": {"type": "boolean"},
        "MaskDeadlock": {"type": "boolean"}
      }
    },
    "conjunct": {
      "type": "object",
      "required": ["conjunct", "in_force", "source"],
      "properties": {
        "conjunct": {"type": "string", "pattern": "^WF_vars\\(.+\\)$"},
        "in_force": {"type": "boolean"},
        "source": {
          "type": "string",
          "pattern": "^(assumed|harness timer|code evidence: .+:[1-9][0-9]*)$"
        }
      }
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fact": {
      "type": "object",
      "required": ["query_id", "file", "line", "joern_version", "graph_hash", "query_sha256"],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "joern_version": {"type": "string", "minLength": 1},
        "graph_hash": {"$ref": "#/$defs/hash"},
        "query_sha256": {"type": "string", "pattern": "^(builtin|[0-9a-f]{64})$"}
      }
    },
    "premises": {
      "type": "object",
      "required": ["session_key_minted", "check_act_atomic", "release_post_dominates",
                   "await_has_timeout", "retry_bounded", "status_before_retry"],
      "additionalProperties": false,
      "properties": {
        "session_key_minted": {"$ref": "#/$defs/premise"},
        "check_act_atomic": {"$ref": "#/$defs/premise"},
        "release_post_dominates": {"$ref": "#/$defs/premise"},
        "await_has_timeout": {"$ref": "#/$defs/premise"},
        "retry_bounded": {"$ref": "#/$defs/premise"},
        "status_before_retry": {"$ref": "#/$defs/premise"}
      }
    },
    "premise": {
      "description": "What one premise rests on. lowered: code matched it and the model may not use that.",
      "type": "object",
      "required": ["status", "lowered"],
      "properties": {
        "status": {"enum": ["pattern", "established", "observed", "assumed", "unknown"]},
        "lowered": {"type": "boolean"},
        "why": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "minItems": 1, "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1}},
        "record": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"lowered": {"const": true}}}, "then": {"required": ["why"]}},
        {"if": {"properties": {"status": {"const": "pattern"}}},
         "then": {"properties": {"lowered": {"const": true}}}},
        {"if": {"properties": {"status": {"enum": ["established", "observed", "assumed"]}}},
         "then": {"properties": {"lowered": {"const": false}}}},
        {"if": {"properties": {"status": {"const": "established"}}}, "then": {"required": ["assumptions"]}},
        {"if": {"properties": {"status": {"const": "observed"}}}, "then": {"required": ["record"]}},
        {"if": {"properties": {"status": {"const": "unknown"}}}, "then": {"required": ["reason"]}}
      ]
    },
    "flag": {
      "type": "object",
      "required": ["value", "provenance"],
      "properties": {
        "value": {"type": "boolean"},
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "provenanced": {
      "type": "object",
      "required": ["value", "provenance"],
      "properties": {"provenance": {"type": "string", "minLength": 1}}
    },
    "trace": {
      "type": "object",
      "required": ["shape", "steps"],
      "properties": {
        "shape": {"enum": ["finite", "stutter", "cycle"]},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action", "state"],
            "properties": {
              "action": {"type": "string", "minLength": 1},
              "state": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
