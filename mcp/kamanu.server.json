{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nkamoah17/kamanu",
  "title": "Kamanu",
  "description": "Verifies a spending limit policy against an engine, explains its verdicts and hunts agent overspend",
  "repository": {
    "url": "https://github.com/nkamoah17/kamanu",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "kamanu",
      "version": "0.1.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
