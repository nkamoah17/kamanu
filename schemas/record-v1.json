{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kamanu.dev/schemas/record-v1.json",
  "title": "KAMANU corpus record, version 1",
  "type": "object",
  "required": [
    "schema",
    "command",
    "engine",
    "date",
    "live",
    "probes",
    "profile",
    "policy",
    "scorecard",
    "fix",
    "kamanu_version",
    "calibration_version",
    "seed",
    "notified"
  ],
  "properties": {
    "schema": {
      "const": "record-v1"
    },
    "command": {
      "enum": [
        "hunt",
        "check",
        "fix"
      ]
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version",
        "third_party"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "third_party": {
          "type": "boolean"
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?Z$"
    },
    "live": {
      "type": "boolean"
    },
    "probes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "answers"
      ],
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "text",
        "shape"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "shape": {
          "type": "string"
        }
      }
    },
    "scorecard": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fix": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "proposed",
            "accepted"
          ]
        }
      ]
    },
    "kamanu_version": {
      "type": "string"
    },
    "calibration_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "notified": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
        }
      ]
    },
    "license": {
      "const": "CDLA-Permissive-2.0"
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "required": [
        "id",
        "request",
        "response",
        "verdict"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        }
      }
    },
    "answer": {
      "type": "object",
      "required": [
        "question",
        "answer",
        "evidence_class"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
