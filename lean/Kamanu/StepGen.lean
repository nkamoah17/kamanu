import Kamanu.RegisterExec

namespace Kamanu
namespace Gen

/-- The moves a call can make (step.json "moves"): label, next status, events, failures, money. -/
def moves (st : Kamanu.Fast.Setting) (c : Kamanu.Fast.Call) : List (Kamanu.Fast.Label × Option Kamanu.Fast.Call × List Int × Nat × Nat) :=
  match c with
  | ⟨a, Kamanu.Fast.St.P⟩ =>
    [ (if st.atomic then (Kamanu.Fast.Label.permit a, some ⟨a, Kamanu.Fast.St.R⟩, [st.d Kamanu.Kind.request a], 0, 0)
       else (Kamanu.Fast.Label.permit a, some ⟨a, Kamanu.Fast.St.A⟩, [], 0, 0)),
      (Kamanu.Fast.Label.deny a, none, st.markDeltas a, 0, 0) ]
  | ⟨a, Kamanu.Fast.St.A⟩ =>
    [ (Kamanu.Fast.Label.record a, some ⟨a, Kamanu.Fast.St.R⟩, [st.d Kamanu.Kind.request a], 0, 0) ]
  | ⟨a, Kamanu.Fast.St.R⟩ =>
    (Kamanu.Fast.Label.succeed a, none, [st.d Kamanu.Kind.response a], 0, a) ::
      ((if st.clean then [(Kamanu.Fast.Label.failClean a, some ⟨a, Kamanu.Fast.St.FC⟩, [st.d Kamanu.Kind.error a], 1, 0)] else []) ++
       (if st.ambiguous then [(Kamanu.Fast.Label.failAmbiguous a, some ⟨a, Kamanu.Fast.St.FM⟩, [st.d Kamanu.Kind.error a], 1, a)] else []))
  | ⟨a, Kamanu.Fast.St.FC⟩ =>
    [ (Kamanu.Fast.Label.refund a, none, [st.d Kamanu.Kind.refund a], 0, 0) ]
  | ⟨a, Kamanu.Fast.St.FM⟩ =>
    [ (Kamanu.Fast.Label.confirm a, none, [st.d Kamanu.Kind.confirm a], 0, 0) ]

theorem moves_eq : Kamanu.Gen.moves = Kamanu.Fast.moves := rfl

/-- What the state must allow for a labelled move (step.json "when": permit, deny, budget). -/
def guardB (st : Kamanu.Fast.Setting) (s : Kamanu.Fast.MState) : Kamanu.Fast.Label → Bool
  | Kamanu.Fast.Label.permit a => Kamanu.Fast.canPermitB st s a
  | Kamanu.Fast.Label.deny a => Kamanu.Fast.canDenyB st s a
  | Kamanu.Fast.Label.failClean _ => decide (s.fails < st.failures)
  | Kamanu.Fast.Label.failAmbiguous _ => decide (s.fails < st.failures)
  | _ => true

theorem guardB_eq : Kamanu.Gen.guardB = Kamanu.Fast.guardB := rfl

/-- Every step the machine can take from `s` (issue, then each call's guarded moves). -/
def succs (st : Kamanu.Fast.Setting) (s : Kamanu.Fast.MState) : List (Kamanu.Fast.Label × Kamanu.Fast.MState) :=
  (if Kamanu.Fast.busy s.slots < st.inFlight then
     st.amounts.map (fun a => (Kamanu.Fast.Label.issue a, { s with slots := ⟨a, Kamanu.Fast.St.P⟩ :: s.slots }))
   else []) ++
  s.slots.flatMap (fun c =>
    ((Kamanu.Gen.moves st c).filter (fun m => Kamanu.Gen.guardB st s m.1)).map
      (fun m => (m.1, Kamanu.Fast.after st s c m.2.1 m.2.2.1 m.2.2.2.1 m.2.2.2.2)))

theorem succs_eq : Kamanu.Gen.succs = Kamanu.Fast.succs := rfl

/-- `fall_t[more]` (step.json clip.fall): the most a call can still take off the register. -/
def Setting.fallT (st : Kamanu.Fast.Setting) (more : Bool) (c : Kamanu.Fast.Call) : Int :=
  match c.st with
  | Kamanu.Fast.St.P => 0
  | Kamanu.Fast.St.A => - st.admMin more c.amt
  | Kamanu.Fast.St.R => - st.runMin more c.amt
  | Kamanu.Fast.St.FC => max 0 (- st.d Kamanu.Kind.refund c.amt)
  | Kamanu.Fast.St.FM => max 0 (- st.d Kamanu.Kind.confirm c.amt)

theorem Setting.fallT_eq : Kamanu.Gen.Setting.fallT = Kamanu.Fast.Setting.fallT := rfl

/-- `rise_t[more]` (step.json clip.rise): the most a call can still add to the register. -/
def Setting.riseT (st : Kamanu.Fast.Setting) (more : Bool) (c : Kamanu.Fast.Call) : Int :=
  match c.st with
  | Kamanu.Fast.St.P => st.admMax more c.amt
  | Kamanu.Fast.St.A => st.admMax more c.amt
  | Kamanu.Fast.St.R => st.runMax more c.amt
  | Kamanu.Fast.St.FC => max 0 (st.d Kamanu.Kind.refund c.amt)
  | Kamanu.Fast.St.FM => max 0 (st.d Kamanu.Kind.confirm c.amt)

theorem Setting.riseT_eq : Kamanu.Gen.Setting.riseT = Kamanu.Fast.Setting.riseT := rfl

/-- `Machine._norm` for one session (step.json clip.hi, clip.lo). -/
def clip (st : Kamanu.Fast.Setting) (s : Kamanu.Fast.MState) : Kamanu.Fast.MState :=
  if st.hiOk ∧ s.v > st.hi0 then
    if Kamanu.Fast.lastBlocksHi st s = true then s
    else if s.v - Kamanu.Fast.isum (Kamanu.Gen.Setting.fallT st (st.moreAt s.fails)) s.slots > st.hi0 then
      { s with v := st.hi0 + 1 + Kamanu.Fast.isum (Kamanu.Gen.Setting.fallT st (st.moreAt s.fails)) s.slots, last := none }
    else s
  else if st.loOk ∧ s.v ≤ st.thetaMin then
    if Kamanu.Fast.lastBlocksLo st s = true then s
    else if s.v + (st.newRise s.fails + Kamanu.Fast.isum (Kamanu.Gen.Setting.riseT st (st.moreAt s.fails)) s.slots)
        ≤ st.thetaMin then
      { s with v := st.thetaMin
                    - (st.newRise s.fails + Kamanu.Fast.isum (Kamanu.Gen.Setting.riseT st (st.moreAt s.fails)) s.slots),
               last := none }
    else s
  else s

theorem clip_eq : Kamanu.Gen.clip = Kamanu.Fast.clip := rfl

/-- What the explorer does to a successor: clip, spent kept up to `cap + 1`, slots in order. -/
def normFull (st : Kamanu.Fast.Setting) (canon : List Kamanu.Fast.Call → List Kamanu.Fast.Call) (s : Kamanu.Fast.MState) : Kamanu.Fast.MState :=
  { Kamanu.Gen.clip st s with
    slots := canon (Kamanu.Gen.clip st s).slots
    spent := min (Kamanu.Gen.clip st s).spent (st.cap + 1) }

theorem normFull_eq : Kamanu.Gen.normFull = Kamanu.Fast.normFull := rfl

end Gen
end Kamanu
