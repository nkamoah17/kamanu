// Action schema for every fixture. Shape from examples/refund_budget_settled_plus_current.
namespace Kamanu {
  type PayInput = {
    amount: Long,
    memo: String
  };

  type PayOutput = {
    approved: Bool
  };

  type SystemContext = {
    now: datetime
  };

  entity Gateway;

  entity OAuthUser = {
    id: String
  } tags String;

  action "Pay" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: PayInput,
      output?: PayOutput,
      system: SystemContext
    }
  };
}
