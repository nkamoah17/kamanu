permit (principal, action == Drupe::Action::"Refund", resource)
when temporal {
  (sum a for (a: Long), (t: Timepoint). where (formerly within 24h (Drupe::Action::"Refund"::request{ input.amount: a } && tp(t)))) - (sum a for (a: Long), (t: Timepoint). where (formerly within 24h (Drupe::Action::"Refund"::error{ input.amount: a } && tp(t)))) <= 100
};
